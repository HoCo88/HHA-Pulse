<Page
    x:Class="HHAPulse.Widget.CompactWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid MinWidth="464" Padding="16">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F00A0D12" Offset="0" />
                <GradientStop Color="#F0161A23" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Border Background="#CC12151E" BorderBrush="#33F97316" BorderThickness="1" CornerRadius="18" Padding="16">
            <StackPanel Spacing="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="2">
                        <TextBlock Text="HHA Pulse" Foreground="White" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock x:Name="ModeText" Text="Standalone companion" Foreground="#FFF97316" FontSize="13" />
                    </StackPanel>

                    <Border x:Name="BadgeBorder" Grid.Column="1" Background="#33212A37" CornerRadius="999" Padding="10,4">
                        <TextBlock x:Name="ConnectionBadgeText" Text="Disconnected" Foreground="White" FontSize="12" />
                    </Border>
                </Grid>

                <TextBlock x:Name="SummaryText" Text="Waiting for overlay telemetry." Foreground="#FFB5BDD0" FontSize="13" TextWrapping="Wrap" />

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock Text="FPS" Foreground="#FF8F99AE" FontSize="12" />
                        <TextBlock x:Name="FpsValueText" Text="--" Foreground="White" FontSize="20" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1">
                        <TextBlock Text="1%" Foreground="#FF8F99AE" FontSize="12" />
                        <TextBlock x:Name="LowValueText" Text="--" Foreground="White" FontSize="20" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2">
                        <TextBlock Text="FT" Foreground="#FF8F99AE" FontSize="12" />
                        <TextBlock x:Name="FrameTimeValueText" Text="--" Foreground="White" FontSize="20" FontWeight="SemiBold" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,12,0,0">
                        <TextBlock Text="CPU" Foreground="#FF8F99AE" FontSize="12" />
                        <TextBlock x:Name="CpuValueText" Text="--" Foreground="White" FontSize="20" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,12,0,0">
                        <TextBlock Text="GPU" Foreground="#FF8F99AE" FontSize="12" />
                        <TextBlock x:Name="GpuValueText" Text="--" Foreground="White" FontSize="20" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,12,0,0">
                        <TextBlock Text="RAM" Foreground="#FF8F99AE" FontSize="12" />
                        <TextBlock x:Name="RamValueText" Text="--" Foreground="White" FontSize="20" FontWeight="SemiBold" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,12,0,0">
                        <TextBlock Text="BAT" Foreground="#FF8F99AE" FontSize="12" />
                        <TextBlock x:Name="BatteryValueText" Text="--" Foreground="White" FontSize="20" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,12,0,0">
                        <TextBlock Text="MODE" Foreground="#FF8F99AE" FontSize="12" />
                        <TextBlock x:Name="ModeValueText" Text="Standalone" Foreground="White" FontSize="20" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,12,0,0">
                        <TextBlock Text="HZ" Foreground="#FF8F99AE" FontSize="12" />
                        <TextBlock x:Name="RefreshValueText" Text="--" Foreground="White" FontSize="20" FontWeight="SemiBold" />
                    </StackPanel>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="StoreButton" Content="Open HHA Pulse" MinHeight="44" MinWidth="140" Click="OnStoreClicked" />
                    <Button x:Name="SupportButton" Grid.Column="1" Content="Support" MinHeight="44" Margin="8,0,0,0" Click="OnSupportClicked" />
                    <TextBlock Grid.Column="2" Text="Powered by Handheld Ally" Foreground="#FFB5BDD0" VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Page>
