<Page
    x:Class="HHAPulse.Widget.CompactWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="16" Background="#CC000000" MinWidth="464">
        <StackPanel Spacing="10">
            <TextBlock Text="HHA Pulse Widget" Foreground="White" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="Standalone Mode" Foreground="#FFFFCC66" />
            <TextBlock Text="Battery and basic metrics available here." Foreground="White" />
            <TextBlock Text="Unlock the full overlay in HHA Pulse." Foreground="White" />
            <HyperlinkButton Content="Open HHA Pulse in Microsoft Store" NavigateUri="ms-windows-store://pdp/?ProductId=XXXXX" />
            <TextBlock Text="Powered by Handheld Ally" Foreground="#FFCCCCCC" />
        </StackPanel>
    </Grid>
</Page>
