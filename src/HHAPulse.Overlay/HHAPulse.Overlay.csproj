<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsPackageType>None</WindowsPackageType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <EnableMsixTooling>true</EnableMsixTooling>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NativeTelemetryDll>$(MSBuildThisFileDirectory)..\HHAPulse.Native\bin\x64\$(Configuration)\HHAPulse.Native.dll</NativeTelemetryDll>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="System.IO.Pipes.AccessControl" />
    <PackageReference Include="NvAPIWrapper.Net" />
    <PackageReference Include="Vortice.DXGI" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\HHAPulse.Shared\HHAPulse.Shared.csproj" />
  </ItemGroup>
  <Target Name="CopyCaptureServiceOutput" AfterTargets="Build;Publish">
    <ItemGroup>
      <CaptureServiceOutput Include="..\HHAPulse.CaptureService\bin\$(Configuration)\net8.0-windows10.0.19041.0\win-x64\**\*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(CaptureServiceOutput)"
      DestinationFiles="@(CaptureServiceOutput->'$(OutDir)%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true"
      Condition="'@(CaptureServiceOutput)' != ''" />
    <Copy
      SourceFiles="@(CaptureServiceOutput)"
      DestinationFiles="@(CaptureServiceOutput->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true"
      Condition="'$(PublishDir)' != '' and '@(CaptureServiceOutput)' != ''" />
  </Target>
  <Target Name="CopyNativeTelemetryOutput" AfterTargets="Build;Publish">
    <Copy
      SourceFiles="$(NativeTelemetryDll)"
      DestinationFolder="$(OutDir)"
      SkipUnchangedFiles="true"
      Condition="Exists('$(NativeTelemetryDll)')" />
    <Copy
      SourceFiles="$(NativeTelemetryDll)"
      DestinationFolder="$(PublishDir)"
      SkipUnchangedFiles="true"
      Condition="'$(PublishDir)' != '' and Exists('$(NativeTelemetryDll)')" />
  </Target>
  <Target Name="VerifyNativeTelemetryForPublish" AfterTargets="Publish">
    <Error
      Condition="'$(PublishDir)' != '' and !Exists('$(NativeTelemetryDll)')"
      Text="HHAPulse.Native.dll was not found at '$(NativeTelemetryDll)'. Build HHAPulse.Native with MSBuild before publishing or packaging HHAPulse.Overlay." />
    <Error
      Condition="'$(PublishDir)' != '' and !Exists('$(PublishDir)HHAPulse.Native.dll')"
      Text="HHAPulse.Native.dll was not copied into publish output at '$(PublishDir)'." />
  </Target>
  <Target Name="VerifyNativeTelemetryForPackage" BeforeTargets="GenerateAppxPackageOnBuild">
    <Error
      Condition="!Exists('$(NativeTelemetryDll)')"
      Text="HHAPulse.Native.dll was not found at '$(NativeTelemetryDll)'. Build HHAPulse.Native with MSBuild before packaging HHAPulse.Overlay." />
  </Target>
</Project>
