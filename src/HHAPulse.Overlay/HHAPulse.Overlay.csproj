<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <EnableMsixTooling>true</EnableMsixTooling>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="System.IO.Pipes.AccessControl" />
    <PackageReference Include="Vortice.DXGI" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\HHAPulse.Shared\HHAPulse.Shared.csproj" />
  </ItemGroup>
  <Target Name="CopyCaptureServiceOutput" AfterTargets="Build">
    <ItemGroup>
      <CaptureServiceOutput Include="..\HHAPulse.CaptureService\bin\$(Configuration)\net8.0-windows10.0.19041.0\win-x64\**\*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(CaptureServiceOutput)"
      DestinationFiles="@(CaptureServiceOutput->'$(OutDir)%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true"
      Condition="'@(CaptureServiceOutput)' != ''" />
  </Target>
</Project>
