<UserControl
    x:Class="HHAPulse.Overlay.Views.CompanionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:HHAPulse.Overlay.Controls"
    xmlns:viewModels="using:HHAPulse.Overlay.ViewModels"
    x:Name="Root">
    <UserControl.Resources>
        <DataTemplate x:Key="PresetCardTemplate" x:DataType="viewModels:CompanionPresetCardModel">
            <Button Tag="{x:Bind Preset}"
                    Style="{StaticResource HhapPresetCardStyle}"
                    Click="OnPresetCardClicked">
                <StackPanel Spacing="10">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{x:Bind Eyebrow}" Style="{StaticResource HhapEyebrowStyle}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Bind Name}" Style="{StaticResource HhapH3Style}" />
                            <Border Grid.Column="1"
                                    Visibility="{x:Bind ActiveVisibility}"
                                    Style="{StaticResource HhapChipBlueStyle}">
                                <TextBlock Text="ACTIVE" Style="{StaticResource HhapMutedStyle}" Foreground="{StaticResource HhapAccentHi}" />
                            </Border>
                        </Grid>
                    </StackPanel>
                    <Border Background="{StaticResource HhapPanel2Brush}"
                            BorderBrush="{StaticResource HhapLineBrush}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="12">
                        <TextBlock Text="{x:Bind Preview}"
                                   Style="{StaticResource HhapEventLineStyle}"
                                   TextWrapping="WrapWholeWords" />
                    </Border>
                    <TextBlock Text="{x:Bind CountText}" Style="{StaticResource HhapMutedStyle}" />
                </StackPanel>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="RootGrid">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="CompanionAdaptive">
                <VisualState x:Name="Lg">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1600" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PulseTitleTextBlock.FontSize" Value="{StaticResource HhapFontH1}" />
                        <Setter Target="SubtitleTextBlock.FontSize" Value="{StaticResource HhapFontBody}" />
                        <Setter Target="PresetSectionTitleTextBlock.FontSize" Value="{StaticResource HhapFontH2}" />
                        <Setter Target="SupportSectionTitleTextBlock.FontSize" Value="{StaticResource HhapFontH3}" />
                        <Setter Target="EventLineLongTextBlock.Visibility" Value="Visible" />
                        <Setter Target="EventLineShortTextBlock.Visibility" Value="Collapsed" />
                        <Setter Target="SupportActionsWide.Visibility" Value="Visible" />
                        <Setter Target="SupportActionsCompact.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Md">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1280" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PulseTitleTextBlock.FontSize" Value="{StaticResource HhapFontH1}" />
                        <Setter Target="SubtitleTextBlock.FontSize" Value="{StaticResource HhapFontBody}" />
                        <Setter Target="PresetSectionTitleTextBlock.FontSize" Value="{StaticResource HhapFontH2}" />
                        <Setter Target="SupportSectionTitleTextBlock.FontSize" Value="{StaticResource HhapFontH3}" />
                        <Setter Target="EventLineLongTextBlock.Visibility" Value="Visible" />
                        <Setter Target="EventLineShortTextBlock.Visibility" Value="Collapsed" />
                        <Setter Target="SupportActionsWide.Visibility" Value="Visible" />
                        <Setter Target="SupportActionsCompact.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Sm">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1024" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PulseTitleTextBlock.FontSize" Value="{StaticResource HhapFontH2}" />
                        <Setter Target="SubtitleTextBlock.FontSize" Value="{StaticResource HhapFontSmall}" />
                        <Setter Target="PresetSectionTitleTextBlock.FontSize" Value="{StaticResource HhapFontH3}" />
                        <Setter Target="SupportSectionTitleTextBlock.FontSize" Value="{StaticResource HhapFontBody}" />
                        <Setter Target="EventLineLongTextBlock.Visibility" Value="Visible" />
                        <Setter Target="EventLineShortTextBlock.Visibility" Value="Collapsed" />
                        <Setter Target="SupportActionsWide.Visibility" Value="Visible" />
                        <Setter Target="SupportActionsCompact.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Xs">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PulseTitleTextBlock.FontSize" Value="{StaticResource HhapFontH3}" />
                        <Setter Target="SubtitleTextBlock.FontSize" Value="{StaticResource HhapFontMicro}" />
                        <Setter Target="PresetSectionTitleTextBlock.FontSize" Value="{StaticResource HhapFontBody}" />
                        <Setter Target="SupportSectionTitleTextBlock.FontSize" Value="{StaticResource HhapFontBody}" />
                        <Setter Target="EventLineLongTextBlock.Visibility" Value="Collapsed" />
                        <Setter Target="EventLineShortTextBlock.Visibility" Value="Visible" />
                        <Setter Target="SupportActionsWide.Visibility" Value="Collapsed" />
                        <Setter Target="SupportActionsCompact.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <StackPanel x:Name="RootStack" Spacing="18">
            <Border Style="{StaticResource HhapCardStyle}">
                <StackPanel Spacing="18">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="54"
                                Height="54"
                                CornerRadius="16"
                                Background="{StaticResource HhapPrimaryGradient}"
                                BorderBrush="{StaticResource HhapLineBrush}"
                                BorderThickness="1">
                            <Viewbox Stretch="Uniform">
                                <TextBlock Text="P"
                                           Foreground="{StaticResource HhapAccentHi}"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center" />
                            </Viewbox>
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock x:Name="PulseTitleTextBlock" Text="Pulse" Style="{StaticResource HhapH1Style}" />
                                    <TextBlock x:Name="SubtitleTextBlock"
                                               Text="One clean control surface for the in-game HUD."
                                               Style="{StaticResource HhapMutedStyle}"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Content="Close overlay"
                                        Style="{StaticResource HhapGhostButtonStyle}"
                                        VerticalAlignment="Top"
                                        Click="OnCloseOverlayClicked" />
                            </Grid>

                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="OverlayChipButton"
                                        Margin="0,0,8,8"
                                        Style="{StaticResource HhapChipButtonStyle}"
                                        Click="OnToggleOverlayClicked">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Ellipse x:Name="OverlayPulseDot"
                                                 Width="8"
                                                 Height="8"
                                                 Style="{StaticResource HhapLivePulseStyle}" />
                                        <TextBlock x:Name="OverlayChipTextBlock" Text="OVERLAY ON" Style="{StaticResource HhapMutedStyle}" />
                                    </StackPanel>
                                </Button>

                                <Border x:Name="CaptureChip" Margin="0,0,8,8" Style="{StaticResource HhapChipStyle}">
                                    <TextBlock x:Name="CaptureChipTextBlock" Text="CAPTURE READY" Style="{StaticResource HhapMutedStyle}" />
                                </Border>

                                <Border Margin="0,0,8,8" Style="{StaticResource HhapChipStyle}">
                                    <TextBlock x:Name="GameTitleTextBlock" Text="NO GAME DETECTED" Style="{StaticResource HhapMutedStyle}" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button x:Name="PositionButton"
                                Grid.Column="0"
                                Style="{StaticResource HhapChipButtonStyle}">
                            <Button.Flyout>
                                <Flyout x:Name="PositionFlyoutRoot"
                                        Placement="BottomEdgeAlignedLeft"
                                        FlyoutPresenterStyle="{StaticResource HhapFlyoutPresenterStyle}">
                                    <controls:PositionFlyout x:Name="PositionFlyoutControl" />
                                </Flyout>
                            </Button.Flyout>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Position:" Style="{StaticResource HhapMutedStyle}" />
                                <TextBlock x:Name="PositionSummaryTextBlock" Style="{StaticResource HhapBodyStyle}" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="FeelAndFitButton"
                                Grid.Column="1"
                                Style="{StaticResource HhapChipButtonStyle}">
                            <Button.Flyout>
                                <Flyout x:Name="FeelAndFitFlyoutRoot"
                                        Placement="BottomEdgeAlignedLeft"
                                        FlyoutPresenterStyle="{StaticResource HhapFlyoutPresenterStyle}">
                                    <controls:FeelAndFitFlyout x:Name="FeelAndFitFlyoutControl" />
                                </Flyout>
                            </Button.Flyout>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Feel &amp; fit:" Style="{StaticResource HhapMutedStyle}" />
                                <TextBlock x:Name="FeelAndFitSummaryTextBlock" Style="{StaticResource HhapBodyStyle}" />
                            </StackPanel>
                        </Button>

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Spacing="8">
                            <Button x:Name="ShowAlwaysButton"
                                    Content="Always on"
                                    Style="{StaticResource HhapChipButtonStyle}"
                                    Click="OnShowAlwaysClicked" />
                            <Button x:Name="ShowInGameButton"
                                    Content="In-game only"
                                    Style="{StaticResource HhapChipButtonStyle}"
                                    Click="OnShowInGameClicked" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <StackPanel Spacing="12">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PresetSectionTitleTextBlock" Grid.Column="0" Text="Choose a preset" Style="{StaticResource HhapH2Style}" />
                    <Button Grid.Column="1" Content="Manual" Style="{StaticResource HhapGhostButtonStyle}" Click="OnManualClicked" />
                </Grid>

                <ItemsRepeater x:Name="PresetRepeater" ItemTemplate="{StaticResource PresetCardTemplate}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="220"
                                           MinColumnSpacing="12"
                                           MinRowSpacing="12"
                                           ItemsStretch="Fill" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </StackPanel>

            <controls:ManualMetricSheet x:Name="ManualMetricSheetControl" Visibility="Collapsed" />

            <Border Style="{StaticResource HhapStatCardStyle}">
                <Grid>
                    <TextBlock x:Name="EventLineLongTextBlock"
                               Style="{StaticResource HhapEventLineStyle}"
                               TextWrapping="WrapWholeWords" />
                    <TextBlock x:Name="EventLineShortTextBlock"
                               Style="{StaticResource HhapEventLineStyle}"
                               TextWrapping="WrapWholeWords"
                               Visibility="Collapsed" />
                </Grid>
            </Border>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource HhapStatCardStyle}">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="6">
                            <TextBlock Text="SUPPORT" Style="{StaticResource HhapEyebrowStyle}" />
                            <TextBlock x:Name="SupportSectionTitleTextBlock" Text="Health and actions" Style="{StaticResource HhapH3Style}" />
                        </StackPanel>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                <Ellipse x:Name="CaptureDot" Width="10" Height="10" Style="{StaticResource HhapBandDotStyle}" />
                                <TextBlock x:Name="CaptureFooterTextBlock" Style="{StaticResource HhapMutedStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Ellipse x:Name="GameDot" Width="10" Height="10" Style="{StaticResource HhapBandDotStyle}" />
                                <TextBlock x:Name="GameFooterTextBlock" Style="{StaticResource HhapMutedStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                <Ellipse x:Name="WidgetDot" Width="10" Height="10" Style="{StaticResource HhapBandDotStyle}" />
                                <TextBlock x:Name="WidgetFooterTextBlock" Style="{StaticResource HhapMutedStyle}" />
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="SupportActionsWide" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="Copy support report" Style="{StaticResource HhapChipButtonStyle}" Click="OnCopyReportClicked" />
                            <Button Grid.Column="1" Content="Open log folder" Style="{StaticResource HhapChipButtonStyle}" Click="OnOpenLogClicked" />
                            <Button Grid.Column="2" Content="handheldally.com" Style="{StaticResource HhapChipButtonStyle}" Click="OnOpenWebsiteClicked" />
                            <Button Grid.Column="3" Content="Community" Style="{StaticResource HhapChipButtonStyle}" Click="OnOpenCommunityClicked" />
                        </Grid>

                        <Grid x:Name="SupportActionsCompact"
                              Visibility="Collapsed"
                              ColumnSpacing="12"
                              RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Button Grid.Row="0" Grid.Column="0" Content="Copy support report" Style="{StaticResource HhapChipButtonStyle}" Click="OnCopyReportClicked" />
                            <Button Grid.Row="0" Grid.Column="1" Content="Open log folder" Style="{StaticResource HhapChipButtonStyle}" Click="OnOpenLogClicked" />
                            <Button Grid.Row="1" Grid.Column="0" Content="handheldally.com" Style="{StaticResource HhapChipButtonStyle}" Click="OnOpenWebsiteClicked" />
                            <Button Grid.Row="1" Grid.Column="1" Content="Community" Style="{StaticResource HhapChipButtonStyle}" Click="OnOpenCommunityClicked" />
                        </Grid>
                    </StackPanel>
                </Border>

                <controls:NpuStatusCard x:Name="NpuStatusCardControl" Grid.Column="1" />
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
