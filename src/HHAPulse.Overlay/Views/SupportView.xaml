<UserControl
    x:Class="HHAPulse.Overlay.Views.SupportView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="20">

        <StackPanel Spacing="8">
            <TextBlock Text="NEED A HAND?" Style="{StaticResource HhapEyebrowStyle}" />
            <TextBlock Text="Support" Style="{StaticResource HhapH1Style}" />
            <TextBlock Text="Check status, grab a support report, or visit the community. Advanced diagnostics stay tucked away unless you ask for them." Style="{StaticResource HhapMutedStyle}" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Status row -->
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource HhapStatCardStyle}" Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock Text="CAPTURE" Style="{StaticResource HhapEyebrowStyle}" />
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="CaptureStatusText" Text="Checking..." Style="{StaticResource HhapH3Style}" TextWrapping="Wrap" />
                        <Border Grid.Column="1" x:Name="CaptureChip" Style="{StaticResource HhapChipStyle}" VerticalAlignment="Center">
                            <TextBlock x:Name="CaptureChipText" Text="--" Style="{StaticResource HhapMutedStyle}" />
                        </Border>
                    </Grid>
                    <TextBlock x:Name="CaptureDetailText" Style="{StaticResource HhapMutedStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource HhapStatCardStyle}" Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock Text="GAME DETECT" Style="{StaticResource HhapEyebrowStyle}" />
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="GameDetectStatusText" Text="Checking..." Style="{StaticResource HhapH3Style}" TextWrapping="Wrap" />
                        <Border Grid.Column="1" x:Name="GameDetectChip" Style="{StaticResource HhapChipStyle}" VerticalAlignment="Center">
                            <TextBlock x:Name="GameDetectChipText" Text="--" Style="{StaticResource HhapMutedStyle}" />
                        </Border>
                    </Grid>
                    <TextBlock x:Name="GameDetectDetailText" Style="{StaticResource HhapMutedStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource HhapStatCardStyle}" Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock Text="COMPANION" Style="{StaticResource HhapEyebrowStyle}" />
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="WidgetStatusText" Text="--" Style="{StaticResource HhapH3Style}" TextWrapping="Wrap" />
                        <Border Grid.Column="1" x:Name="WidgetChip" Style="{StaticResource HhapChipStyle}" VerticalAlignment="Center">
                            <TextBlock x:Name="WidgetChipText" Text="--" Style="{StaticResource HhapMutedStyle}" />
                        </Border>
                    </Grid>
                    <TextBlock x:Name="WidgetDetailText" Style="{StaticResource HhapMutedStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Action row -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Copy support report" Style="{StaticResource HhapChipButtonStyle}" HorizontalAlignment="Stretch" Click="OnCopyReport" />
            <Button Grid.Column="1" Content="Open log folder" Style="{StaticResource HhapChipButtonStyle}" HorizontalAlignment="Stretch" Click="OnOpenLog" />
            <Button Grid.Column="2" Content="Visit Handheld Ally" Style="{StaticResource HhapChipButtonStyle}" HorizontalAlignment="Stretch" Click="OnOpenWebsite" />
            <Button Grid.Column="3" Content="Community" Style="{StaticResource HhapChipButtonStyle}" HorizontalAlignment="Stretch" Click="OnOpenCommunity" />
        </Grid>

        <!-- Support development (tip jar) -->
        <Border Style="{StaticResource HhapStatCardStyle}" Padding="20">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="6">
                    <TextBlock Text="SUPPORT DEVELOPMENT" Style="{StaticResource HhapEyebrowStyle}" />
                    <TextBlock Text="Handheld Ally Pulse is a one-time purchase. If you want to support future updates, you can tip the developer." Style="{StaticResource HhapMutedStyle}" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Content="Tip jar" Style="{StaticResource HhapGhostButtonStyle}" VerticalAlignment="Center" Click="OnOpenTipJar" />
            </Grid>
        </Border>

        <!-- Collapsed diagnostics -->
        <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="False">
            <Expander.Header>
                <TextBlock Text="Advanced diagnostics" Style="{StaticResource HhapH3Style}" />
            </Expander.Header>
            <StackPanel Spacing="12" Padding="0,12,0,0">
                <TextBlock x:Name="AboutVersionText" Style="{StaticResource HhapMutedStyle}" TextWrapping="Wrap" />
                <TextBlock x:Name="ContractStatusText" Style="{StaticResource HhapMutedStyle}" TextWrapping="Wrap" />
                <TextBlock x:Name="NativeBridgeText" Style="{StaticResource HhapMutedStyle}" TextWrapping="Wrap" />
                <TextBlock x:Name="TraceabilityText" Style="{StaticResource HhapMutedStyle}" TextWrapping="Wrap" />
                <ScrollViewer MaxHeight="320" HorizontalScrollMode="Disabled">
                    <TextBlock x:Name="DiagnosticsDumpText" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource HhapTextBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                </ScrollViewer>
                <Button Content="Copy dump" Style="{StaticResource HhapChipButtonStyle}" HorizontalAlignment="Left" Click="OnCopyReport" />
            </StackPanel>
        </Expander>

        <Button Content="Close overlay" Style="{StaticResource HhapGhostButtonStyle}" HorizontalAlignment="Stretch" Click="OnExitClicked" />

    </StackPanel>
</UserControl>
