<Page
    x:Class="HHAPulse.Overlay.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Padding="24" Spacing="12">
        <TextBlock Text="Settings" FontSize="24" />
        <TextBlock Text="Transparency" />
        <Slider Minimum="0" Maximum="1" Value="0.85" />
        <TextBlock Text="Update interval" />
        <ComboBox SelectedIndex="1">
            <ComboBoxItem Content="0.5s" />
            <ComboBoxItem Content="1s" />
            <ComboBoxItem Content="2s" />
        </ComboBox>
    </StackPanel>
</Page>
