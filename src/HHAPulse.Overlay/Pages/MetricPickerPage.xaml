<Page
    x:Class="HHAPulse.Overlay.Pages.MetricPickerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Padding="24" Spacing="12">
        <TextBlock Text="Metric Picker" FontSize="24" />
        <CheckBox Content="FPS" IsChecked="True" />
        <CheckBox Content="Battery" IsChecked="True" />
        <CheckBox Content="CPU" />
        <CheckBox Content="GPU" />
    </StackPanel>
</Page>
