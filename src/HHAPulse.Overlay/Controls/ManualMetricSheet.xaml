<UserControl
    x:Class="HHAPulse.Overlay.Controls.ManualMetricSheet"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource HhapStatCardStyle}">
        <StackPanel Spacing="16">
            <StackPanel Spacing="4">
                <TextBlock Text="MANUAL" Style="{StaticResource HhapEyebrowStyle}" />
                <TextBlock Text="Build your own" Style="{StaticResource HhapH3Style}" />
                <TextBlock x:Name="SummaryText"
                           Style="{StaticResource HhapMutedStyle}"
                           Text="Manual starts as a copy of the current preset."
                           TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel x:Name="GroupHost" Spacing="14" />
        </StackPanel>
    </Border>
</UserControl>
