<UserControl
    x:Class="HHAPulse.Overlay.Controls.MetricLabel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Orientation="Horizontal" Spacing="4">
        <TextBlock x:Name="LabelText" Foreground="#FFCCCCCC" />
        <TextBlock x:Name="ValueText" Foreground="White" FontWeight="SemiBold" />
        <TextBlock x:Name="UnitText" Foreground="#FFCCCCCC" />
    </StackPanel>
</UserControl>
