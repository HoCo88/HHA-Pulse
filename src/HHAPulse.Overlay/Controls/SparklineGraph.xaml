<UserControl
    x:Class="HHAPulse.Overlay.Controls.SparklineGraph"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border x:Name="GraphBorder"
            MinWidth="80"
            MinHeight="20"
            Background="{StaticResource HhapHudTileBgBrush}"
            BorderBrush="{StaticResource HhapHudTileBorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource HhapRadiusTile}"
            Padding="2,1,2,1">
        <Canvas x:Name="GraphCanvas" />
    </Border>
</UserControl>
