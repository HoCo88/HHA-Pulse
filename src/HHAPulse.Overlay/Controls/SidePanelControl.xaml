<UserControl
    x:Class="HHAPulse.Overlay.Controls.SidePanelControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:HHAPulse.Overlay.Controls">
    <Border Width="260" Background="#CC000000" Padding="12">
        <ScrollViewer>
            <StackPanel Spacing="12">
                <TextBlock Text="Diagnostic" Foreground="White" FontSize="18" FontWeight="SemiBold" />
                <controls:LargeGraph />
                <TextBlock Text="Performance" Foreground="#FFCCCCCC" />
                <controls:BottleneckIndicator />
                <controls:FrameGenBadge />
                <TextBlock Text="Battery" Foreground="#FFCCCCCC" />
                <controls:BatteryMeter />
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
