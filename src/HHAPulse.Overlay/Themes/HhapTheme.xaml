<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =============================================================== -->
    <!-- HHA Pulse design tokens — dark only. Values sourced from the -->
    <!-- preview.html mockup; alpha channels converted to AARRGGBB hex. -->
    <!-- =============================================================== -->

    <!-- Backgrounds -->
    <SolidColorBrush x:Key="HhapBgBrush" Color="#FF050916" />
    <SolidColorBrush x:Key="HhapBg2Brush" Color="#FF0A1020" />
    <SolidColorBrush x:Key="HhapPanelBrush" Color="#E60C1223" />
    <SolidColorBrush x:Key="HhapPanel2Brush" Color="#EB121B32" />
    <SolidColorBrush x:Key="HhapPanel3Brush" Color="#F00A0F1C" />

    <!-- Lines / strokes -->
    <SolidColorBrush x:Key="HhapLineBrush" Color="#297596FF" />
    <SolidColorBrush x:Key="HhapLineStrongBrush" Color="#4756C7FF" />

    <!-- Text -->
    <SolidColorBrush x:Key="HhapTextBrush" Color="#FFF4F7FF" />
    <SolidColorBrush x:Key="HhapMutedBrush" Color="#FF95A0BD" />
    <SolidColorBrush x:Key="HhapMuted2Brush" Color="#FF7F89A9" />

    <!-- Accent colours -->
    <SolidColorBrush x:Key="HhapBlueBrush" Color="#FF58CBFF" />
    <SolidColorBrush x:Key="HhapBlue2Brush" Color="#FF9AE7FF" />
    <SolidColorBrush x:Key="HhapAmberBrush" Color="#FFFF9D3D" />
    <SolidColorBrush x:Key="HhapAmber2Brush" Color="#FFFFCB6C" />
    <SolidColorBrush x:Key="HhapGreenBrush" Color="#FF55E08E" />
    <SolidColorBrush x:Key="HhapRedBrush" Color="#FFFF708F" />
    <SolidColorBrush x:Key="HhapPurpleBrush" Color="#FF9076FF" />

    <!-- Scrim + in-game HUD -->
    <SolidColorBrush x:Key="HhapScrimBrush" Color="#B3050916" />
    <SolidColorBrush x:Key="HhapHudBgBrush" Color="#D90A101F" />
    <SolidColorBrush x:Key="HhapHudTileBgBrush" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="HhapHudTileBorderBrush" Color="#0FFFFFFF" />

    <!-- Gradients -->
    <LinearGradientBrush x:Key="HhapPrimaryGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#3358CBFF" />
        <GradientStop Offset="1" Color="#1A58CBFF" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HhapHeroGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#EB0E1527" />
        <GradientStop Offset="1" Color="#F20A0F1E" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HhapRailGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#F5080C17" />
        <GradientStop Offset="1" Color="#F5060A14" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HhapSliderFillGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#FF58CBFF" />
        <GradientStop Offset="1" Color="#FF9AE7FF" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HhapSparklineStrokeGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#FF58CBFF" />
        <GradientStop Offset="1" Color="#FF9AE7FF" />
    </LinearGradientBrush>

    <!-- Radii -->
    <CornerRadius x:Key="HhapRadius">26</CornerRadius>
    <CornerRadius x:Key="HhapRadiusSm">18</CornerRadius>
    <CornerRadius x:Key="HhapRadiusShell">32</CornerRadius>
    <CornerRadius x:Key="HhapRadiusTile">14</CornerRadius>
    <CornerRadius x:Key="HhapRadiusPill">999</CornerRadius>

    <!-- Spacing -->
    <x:Double x:Key="HhapSpace1">4</x:Double>
    <x:Double x:Key="HhapSpace2">8</x:Double>
    <x:Double x:Key="HhapSpace3">12</x:Double>
    <x:Double x:Key="HhapSpace4">16</x:Double>
    <x:Double x:Key="HhapSpace5">20</x:Double>
    <x:Double x:Key="HhapSpace6">24</x:Double>
    <x:Double x:Key="HhapSpace7">28</x:Double>

    <!-- Typography — font family -->
    <FontFamily x:Key="HhapFontFamily">Segoe UI</FontFamily>

    <!-- Typography — sizes -->
    <x:Double x:Key="HhapFontHero">54</x:Double>
    <x:Double x:Key="HhapFontH1">28</x:Double>
    <x:Double x:Key="HhapFontH2">24</x:Double>
    <x:Double x:Key="HhapFontH3">21</x:Double>
    <x:Double x:Key="HhapFontBody">15</x:Double>
    <x:Double x:Key="HhapFontSmall">13</x:Double>
    <x:Double x:Key="HhapFontMicro">12</x:Double>
    <x:Double x:Key="HhapFontEyebrow">12</x:Double>
    <x:Double x:Key="HhapFontHudValue">23</x:Double>
    <x:Double x:Key="HhapFontHudLabel">11</x:Double>

    <!-- Typography — character spacing (1/1000 em) -->
    <x:Int32 x:Key="HhapTrackHero">-50</x:Int32>
    <x:Int32 x:Key="HhapTrackHeadline">-30</x:Int32>
    <x:Int32 x:Key="HhapTrackEyebrow">120</x:Int32>
    <x:Int32 x:Key="HhapTrackHudLabel">80</x:Int32>
    <x:Int32 x:Key="HhapTrackHudValue">-40</x:Int32>

</ResourceDictionary>
