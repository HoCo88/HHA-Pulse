<Window
    x:Class="HHAPulse.Overlay.ControlWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Background="#FF0C0C12" VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="28,24,28,24" Spacing="24">

            <!-- Header -->
            <StackPanel Spacing="4">
                <TextBlock Text="HHA Pulse" Foreground="White" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="Performance overlay for Windows handhelds" Foreground="#FF888899" FontSize="13" />
            </StackPanel>

            <!-- Preset section -->
            <StackPanel Spacing="10">
                <TextBlock Text="PRESET" Foreground="#FF666680" FontSize="11" FontWeight="SemiBold" CharacterSpacing="80" />
                <Grid Background="#FF16161E" CornerRadius="8" Padding="16,14,16,14">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="PresetMinimalButton" Content="Minimal" MinWidth="72" MinHeight="36" Click="OnPresetMinimalClicked" />
                            <Button x:Name="PresetStandardButton" Content="Standard" MinWidth="80" MinHeight="36" Click="OnPresetStandardClicked" />
                            <Button x:Name="PresetTunerButton" Content="Tuner" MinWidth="72" MinHeight="36" Click="OnPresetTunerClicked" />
                            <Button x:Name="PresetCustomButton" Content="Custom" MinWidth="72" MinHeight="36" Click="OnPresetCustomClicked" />
                            <Button x:Name="PresetOffButton" Content="Off" MinWidth="52" MinHeight="36" Click="OnPresetOffClicked" />
                        </StackPanel>
                        <TextBlock x:Name="PresetDescription" Text="Standard: FPS, frametime, CPU, GPU, battery." Foreground="#FF888899" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- Custom metric picker (hidden unless Custom preset active) -->
            <StackPanel x:Name="MetricPickerSection" Spacing="10" Visibility="Collapsed">
                <TextBlock Text="CUSTOM METRICS" Foreground="#FF666680" FontSize="11" FontWeight="SemiBold" CharacterSpacing="80" />
                <Grid Background="#FF16161E" CornerRadius="8" Padding="16,14,16,14">
                    <StackPanel x:Name="MetricPickerPanel" Spacing="6" />
                </Grid>
            </StackPanel>

            <!-- Overlay visibility section -->
            <StackPanel Spacing="10">
                <TextBlock Text="VISIBILITY" Foreground="#FF666680" FontSize="11" FontWeight="SemiBold" CharacterSpacing="80" />
                <Grid Background="#FF16161E" CornerRadius="8" Padding="16,14,16,14">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="ShowAlwaysButton" Content="Always" MinWidth="72" MinHeight="36" Click="OnShowAlwaysClicked" />
                            <Button x:Name="ShowInGameButton" Content="In-game only" MinWidth="100" MinHeight="36" Click="OnShowInGameClicked" />
                            <Button Content="Show / hide" MinWidth="90" MinHeight="36" Click="OnToggleOverlayClicked" />
                        </StackPanel>
                        <TextBlock x:Name="ShowModeDescription" Text="Overlay is always visible." Foreground="#FF888899" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- Appearance section -->
            <StackPanel Spacing="10">
                <TextBlock Text="APPEARANCE" Foreground="#FF666680" FontSize="11" FontWeight="SemiBold" CharacterSpacing="80" />
                <Grid Background="#FF16161E" CornerRadius="8" Padding="16,14,16,14">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Background" Foreground="#FFCCCCDD" FontSize="13" VerticalAlignment="Center" Width="100" />
                                <TextBlock x:Name="BgOpacityValue" Text="85%" Foreground="#FF888899" FontSize="13" VerticalAlignment="Center" Width="36" />
                            </StackPanel>
                            <Slider x:Name="BgOpacitySlider" Minimum="0" Maximum="100" Value="85" StepFrequency="5"
                                    ValueChanged="OnBgOpacityChanged" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Text" Foreground="#FFCCCCDD" FontSize="13" VerticalAlignment="Center" Width="100" />
                                <TextBlock x:Name="TextOpacityValue" Text="100%" Foreground="#FF888899" FontSize="13" VerticalAlignment="Center" Width="36" />
                            </StackPanel>
                            <Slider x:Name="TextOpacitySlider" Minimum="20" Maximum="100" Value="100" StepFrequency="5"
                                    ValueChanged="OnTextOpacityChanged" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Text size" Foreground="#FFCCCCDD" FontSize="13" VerticalAlignment="Center" Width="100" />
                                <TextBlock x:Name="TextSizeValue" Text="15" Foreground="#FF888899" FontSize="13" VerticalAlignment="Center" Width="36" />
                            </StackPanel>
                            <Slider x:Name="TextSizeSlider" Minimum="10" Maximum="22" Value="15" StepFrequency="1"
                                    ValueChanged="OnTextSizeChanged" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- FPS tracking section -->
            <StackPanel Spacing="10">
                <TextBlock Text="FPS CAPTURE" Foreground="#FF666680" FontSize="11" FontWeight="SemiBold" CharacterSpacing="80" />
                <Grid Background="#FF16161E" CornerRadius="8" Padding="16,14,16,14">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse x:Name="CaptureStatusDot" Width="8" Height="8" Fill="#FF555566" VerticalAlignment="Center" />
                            <TextBlock x:Name="CaptureStatusText" Text="Not connected" Foreground="#FFCCCCDD" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Content="Enable FPS tracking" HorizontalAlignment="Left" MinHeight="36" Click="OnEnableCaptureClicked" />
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- Footer -->
            <StackPanel Spacing="12">
                <TextBlock x:Name="LogPathText" Foreground="#FF444455" FontSize="11" TextWrapping="Wrap" />
                <Button Content="Exit HHA Pulse" HorizontalAlignment="Left" MinHeight="36" Click="OnExitClicked" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Window>
