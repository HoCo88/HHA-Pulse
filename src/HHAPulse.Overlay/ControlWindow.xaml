<Window
    x:Class="HHAPulse.Overlay.ControlWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:HHAPulse.Overlay.Views">

    <Grid x:Name="ShellRoot" Background="{StaticResource HhapBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBarDragRegion"
              Grid.Row="0"
              Background="Transparent"
              Margin="0,0,160,0" />

        <Border Grid.Row="1"
                Margin="16,0,16,16"
                Background="{StaticResource HhapPanel3Brush}"
                BorderBrush="{StaticResource HhapLineBrush}"
                BorderThickness="1"
                CornerRadius="26">
            <ScrollViewer VerticalScrollMode="Enabled"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollMode="Disabled"
                          HorizontalScrollBarVisibility="Disabled"
                          ZoomMode="Disabled"
                          IsVerticalScrollChainingEnabled="True"
                          Padding="24,24,24,28">
                <views:CompanionView x:Name="CompanionViewControl" />
            </ScrollViewer>
        </Border>
    </Grid>

</Window>
