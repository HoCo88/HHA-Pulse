<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop rescap">
  <Identity Name="HandheldAlly.HHAPulse" Publisher="CN=Handheld Ally" Version="1.0.0.0" />
  <Properties>
    <DisplayName>HHA Pulse</DisplayName>
    <PublisherDisplayName>Handheld Ally</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Resources>
    <Resource Language="en-us" />
  </Resources>
  <Applications>
    <Application Id="App" Executable="HHAPulse.Overlay.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="HHA Pulse" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png" Description="Windows handheld performance overlay" BackgroundColor="transparent" />
      <Extensions>
        <desktop:Extension Category="windows.fullTrustProcess" Executable="HHAPulse.Overlay.exe" />
        <desktop:Extension Category="windows.startupTask" Executable="HHAPulse.Overlay.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="HHAPulseStartup" Enabled="false" DisplayName="HHA Pulse" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
